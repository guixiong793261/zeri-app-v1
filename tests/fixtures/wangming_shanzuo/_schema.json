{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wangming_shanzuo_fixture_v1",
  "title": "仙命×坐山判定回归用例 fixture（v1）",
  "description": "安葬路径 仙命（亡命）纳音五行 × 坐山正五行 生克判定的回归锚点。每条用例先跑纯函数 evaluate_wangming_vs_shanzuo；input 含 date + wangming_birth_date 时追加评分器集成断言。",
  "type": "object",
  "required": ["schema", "case_id", "category", "description", "input", "expected"],
  "properties": {
    "schema": {"const": "wangming_shanzuo_fixture_v1"},
    "case_id": {"type": "string", "description": "用例唯一编号，basic 用三位序号，boundary/integration 用语义名"},
    "category": {"enum": ["basic", "boundary", "integration"]},
    "description": {"type": "string"},
    "allOf": [
      {
        "if": {"properties": {"category": {"const": "integration"}}, "required": ["category"]},
        "then": {
          "properties": {
            "input": {"required": ["date", "wangming_birth_date", "event"]}
          },
          "required": ["input"]
        }
      }
    ],
    "input": {
      "type": "object",
      "required": ["wangming_ganzhi", "wangming_nayin", "wangming_nayin_wuxing", "shanzuo", "shanzuo_wuxing"],
      "properties": {
        "wangming_ganzhi": {"type": "string", "description": "亡命生年干支，如 甲子"},
        "wangming_nayin": {"type": "string", "description": "纳音名，如 海中金"},
        "wangming_nayin_wuxing": {"enum": ["金", "木", "水", "火", "土"]},
        "shanzuo": {"type": "string", "description": "完整山向，如 甲山庚向（仅正向山，兼向见 §59.7 TODO）"},
        "shanzuo_wuxing": {"enum": ["金", "木", "水", "火", "土"], "description": "坐山正五行"},
        "date": {"type": "string", "format": "date", "description": "集成断言日期；存在即跑评分器"},
        "wangming_birth_date": {"type": "string", "format": "date", "description": "亡命公历生日（构建死者卡用）"},
        "event": {"type": "string", "default": "安葬"}
      }
    },
    "expected": {
      "type": "object",
      "required": ["relation", "score", "level"],
      "properties": {
        "relation": {"enum": ["坐山生仙命", "仙命生坐山", "比和", "仙命克坐山", "坐山克仙命", "未知"]},
        "score": {"type": "integer", "description": "纯函数基础分：+20/+10/0/-15/-30"},
        "level": {"enum": ["大吉", "小吉", "平", "小凶", "凶中之凶"], "description": "纯函数关系等级（非展示等级）"},
        "reason_contains": {"type": "array", "items": {"type": "string"}, "description": "reason 关键词（包含即可，不做全文匹配）"},
        "veto": {"type": "boolean", "description": "集成：veto_reasons 是否非空"},
        "level_cap": {"type": "boolean", "description": "集成：展示等级是否被封顶（以 ❌ 凶 开头）"},
        "report_level": {"type": "string", "description": "集成（可选）：展示等级精确值"},
        "final_score": {"type": "integer", "description": "集成（可选）：最终总分精确值"}
      }
    },
    "notes": {"type": "string", "description": "人工复查备注，不参与断言"}
  },
  "example": {
    "schema": "wangming_shanzuo_fixture_v1",
    "case_id": "001",
    "category": "basic",
    "description": "甲子亡命 × 甲山庚向，仙命克坐山",
    "input": {
      "wangming_ganzhi": "甲子",
      "wangming_nayin": "海中金",
      "wangming_nayin_wuxing": "金",
      "shanzuo": "甲山庚向",
      "shanzuo_wuxing": "木",
      "date": "2024-03-03",
      "wangming_birth_date": "1924-03-01",
      "event": "安葬"
    },
    "expected": {
      "relation": "仙命克坐山",
      "score": -15,
      "level": "小凶",
      "reason_contains": ["仙命", "克", "坐山"],
      "veto": false,
      "level_cap": false,
      "final_score": 100
    },
    "notes": "金克木，仙命克坐山，小凶仅扣分不否决"
  }
}
