# 备份目录 - 太深嵌套导致Git无法处理
备份/

# Python缓存
__pycache__/
*.pyc
*.pyo

# 构建产物
build/
dist/
*.spec

# 日志文件
*.log
logs/

# 隐藏文件
.git/
.trae/

# IDE 生成的 HTML 分享缓存（2026-10-31 001 §211：IDE 缓存目录，不入库）
.trae-html-share-packages/

# 临时导出 PDF（2026-10-31 001 §211：打印/分享临时产物，不存 PDF）
*.pdf

# 运行数据（用户方案/择日记录，本地保留不入库；2026-09-18 移出跟踪）
data/owners_plans.json
/择日记录.json
**/择日记录.json

# 打包生成物（每次构建内容都变，不适合入库；2026-09-18 移出跟踪）
手机一键部署包.zip
/择日软件_完整单文件版.py
手机一键部署/单文件版/
# 2026-10-13 补收口：手机版（3.6MB，2026-09-13 自动构建勿手改）与
# 模块完整版/单文件版/（1.1MB 嵌入压缩模块字典，integrate 产物漏网副本）
手机一键部署/择日软件手机版.py
手机一键部署/模块完整版/单文件版/

# LLM 基线（2026-10-05）：固定锚点 llm_baseline_20261002/03.json 已入库跟踪，
# 未来新生成的基线文件不入库（已跟踪文件不受 gitignore 影响）
data/llm_baseline_*.json
data/tmp/

# 审计可复现大数据（2026-10-13 拍板：脚本+manifest+SEED 在仓即可复现，
# raw/per_event/agg/compare 等大体积产物不进仓；工作区本地保留）。
# 例外：s63_veto_tuning/veto_audit_old|new.json 为不可复现校准基线，保留在仓。
tools/audit/**/veto_remain_raw_*.json
tools/audit/**/veto_remain_per_event_*.json
tools/audit/**/veto_remain_agg_*.json
tools/audit/**/s64_compare_*.json
